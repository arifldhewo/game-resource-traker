# PRTS Forecast — environment template
#
# This app is a static export with no backend or database, so no secrets are
# required. Copy this file to .env.local only if you need a local override:
#
#   cp .env.example .env.local
#
# .env.local is gitignored and never committed.

# Version string shown in the footer.
# Injected automatically from package.json by next.config.ts at build time,
# so leave this commented out unless you need to override the build value.
# NEXT_PUBLIC_APP_VERSION=0.0.0
